# Application
APP_NAME=SANA Health Platform
VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-this

# Database
DATABASE_URL=postgresql://sana_user:sana_password@localhost:5432/sana_db

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_V1_PREFIX=/api/v1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.sana.health

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# SendGrid
SENDGRID_API_KEY=SG.xxx
FROM_EMAIL=noreply@sana.health

# AWS S3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
S3_BUCKET_NAME=sana-uploads

# Firebase
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json

# Frontend URLs
FRONTEND_URL=https://app.sana.health
ADMIN_URL=https://admin.sana.health

# Monitoring
SENTRY_DSN=https://xxx@sentry.io/xxx
