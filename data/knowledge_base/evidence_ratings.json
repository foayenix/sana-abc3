      "recommendation": "Recommended for most patients"
    },
    "moderate": {
      "description": "Some RCTs or high-quality observational studies",
      "confidence": "Moderate confidence in effectiveness",
      "recommendation": "Consider for appropriate patients"
    },
    "weak": {
      "description": "Limited studies or inconsistent results",
      "confidence": "Low confidence in effectiveness",
      "recommendation": "May consider with informed consent"
    },
    "insufficient": {
